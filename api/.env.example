# Modelo de configuração da API.
#
# O container copia este arquivo para .env na primeira subida e gera a APP_KEY
# automaticamente. Nenhum segredo real é versionado aqui.

APP_NAME="Solicitacoes de Atendimento"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

# --- Banco ---
# O host é "db", o nome do serviço no docker-compose.yml.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=solicitacoes
DB_USERNAME=vlab
DB_PASSWORD=vlab_dev

# --- Drivers ---
# Esta é uma API REST sem estado e sem autenticação: não usa sessão, não
# enfileira trabalho e não precisa de cache em banco. Os drivers abaixo mantêm
# o schema restrito ao domínio, com uma única tabela de negócio.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

LOG_CHANNEL=stack
LOG_LEVEL=debug

MAIL_MAILER=log
