# Copie para .env antes de subir o ambiente:  cp .env.example .env
# Nenhum segredo real deve ser versionado neste arquivo.

# --- Banco ---
# Estes valores configuram o container do Postgres.
# O Laravel le as credenciais dele de api/.env, entao os dois precisam bater.
# Se mudar aqui, mude tambem em api/.env e api/.env.example.
DB_DATABASE=solicitacoes
DB_USERNAME=vlab
DB_PASSWORD=vlab_dev
DB_PORT_HOST=5433

# --- API (Laravel) ---
APP_ENV=local
APP_DEBUG=true
API_PORT=8000

# --- Frontend (React + Vite) ---
WEB_PORT=5173
VITE_API_URL=http://localhost:8000/api/v1
